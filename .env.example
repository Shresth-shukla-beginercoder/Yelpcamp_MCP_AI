# Gemini (server-side only — never exposed to the browser)
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use for tool-calling. Defaults to gemini-3.8-flash in code if unset.
# (Older models like gemini-1.5-flash / gemini-2.5-flash are retired or gated
#  for some accounts and return 404 — check ListModels for what your key can use.)
GEMINI_MODEL=gemini-3.8-flash

# YelpCamp Express chat API the MCP tools call (service-to-service)
YELPCAMP_API_URL=http://localhost:3000
# MUST match YELPCAMP_CHAT_SERVICE_TOKEN in the Express project's .env
YELPCAMP_CHAT_SERVICE_TOKEN=dev-chat-service-token

# Comma-separated origins allowed to call /chat from the browser
CHAT_ALLOWED_ORIGINS=http://localhost:3000
